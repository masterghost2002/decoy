{
  "name": "@decoy/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drive Decoy from an agent: mock an endpoint while you build the code that calls it.",
  "bin": {
    "decoy-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@decoy/core": "workspace:*",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.0"
  }
}
